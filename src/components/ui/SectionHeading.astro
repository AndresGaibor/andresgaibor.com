---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{eyebrow}</p>}
  <h2 class="text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg">{description}</p>}
</div>
