---
interface Props {
  label?: string;
}
const { label = 'Vista conceptual' } = Astro.props;
---

<span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.1em] text-[var(--muted)]">
  <svg class="size-2.5 shrink-0" viewBox="0 0 6 6" fill="currentColor"><circle cx="3" cy="3" r="3"/></svg>
  {label}
</span>
