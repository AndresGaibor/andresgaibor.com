---
import Container from '../ui/Container.astro';
import { profile } from '../../data/profile';

const path = Astro.url.pathname;
const nav = [
  { href: '/#servicios', label: 'Servicios', section: true },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/cv', label: 'CV' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[color:var(--page)]/90 backdrop-blur-xl">
  <Container class="flex min-h-16 items-center justify-between gap-3 py-3">
    <a
      href="/"
      class="flex min-h-11 min-w-11 items-center gap-3 rounded-lg font-semibold tracking-tight no-underline"
      aria-label="Ir al inicio"
    >
      <span class="grid size-9 place-items-center rounded-xl border border-[var(--line)] bg-[var(--surface)] text-sm">
        {profile.shortName}
      </span>
      <span class="hidden sm:inline">{profile.name}</span>
    </a>

    <div class="flex items-center gap-1 text-sm">
      <nav aria-label="Navegación principal" class="hidden items-center gap-1 sm:flex">
        {nav.map((item) => {
          const active = !item.section && (path === item.href || path.startsWith(`${item.href}/`));
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex min-h-11 items-center rounded-lg px-3 py-2 no-underline transition-colors',
                active
                  ? 'bg-[var(--surface-soft)] text-[var(--text)]'
                  : 'text-[var(--muted)] hover:text-[var(--text)]',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <a
        href="/contacto"
        class="flex min-h-11 items-center rounded-lg bg-[var(--text)] px-3 font-semibold text-[var(--page)] no-underline"
      >
        Hablemos
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="min-h-11 rounded-lg border border-[var(--line)] px-3 text-[var(--muted)] transition-colors hover:text-[var(--text)]"
        aria-label="Cambiar a tema oscuro"
        aria-pressed="false"
        data-theme-toggle
      >
        Tema
      </button>
      <details class="relative sm:hidden">
        <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-lg border border-[var(--line)] bg-[var(--surface)] px-3 font-semibold text-[var(--muted)]">
          Menú
        </summary>
        <div class="absolute right-0 top-full z-50 mt-2 min-w-48 rounded-xl border border-[var(--line)] bg-[var(--surface)] p-2 shadow-lg">
          <nav aria-label="Navegación móvil" class="grid gap-1">
            {nav.map((item) => {
              const active = !item.section && (path === item.href || path.startsWith(`${item.href}/`));
              return (
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 items-center rounded-lg px-3 py-2 no-underline transition-colors',
                    active
                      ? 'bg-[var(--surface-soft)] text-[var(--text)]'
                      : 'text-[var(--muted)] hover:text-[var(--text)]',
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>
        </div>
      </details>
    </div>
  </Container>
</header>
