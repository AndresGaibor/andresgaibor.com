---
import Container from '../ui/Container.astro';
import { profile } from '../../data/profile';

const path = Astro.url.pathname;
const nav = [
  { href: '/#servicios', label: 'Servicios', section: true },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/cv', label: 'CV' },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[color:var(--page)]/90 backdrop-blur-xl">
  <Container class="flex min-h-16 items-center justify-between gap-5 py-3">
    <a
      href="/"
      class="flex items-center gap-3 font-semibold tracking-tight no-underline"
      aria-label="Ir al inicio"
    >
      <span class="grid size-9 place-items-center rounded-xl border border-[var(--line)] bg-[var(--surface)] text-sm">
        {profile.shortName}
      </span>
      <span class="hidden sm:inline">{profile.name}</span>
    </a>

    <nav aria-label="Navegación principal" class="flex items-center gap-1 overflow-x-auto text-sm">
      {nav.map((item) => {
        const active = !item.section && (path === item.href || path.startsWith(`${item.href}/`));
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 no-underline transition-colors',
              active
                ? 'bg-[var(--surface-soft)] text-[var(--text)]'
                : 'text-[var(--muted)] hover:text-[var(--text)]',
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <a
        href="/contacto"
        class="ml-1 rounded-lg bg-[var(--text)] px-3 py-2 font-semibold text-[var(--page)] no-underline"
      >
        Hablemos
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-lg border border-[var(--line)] px-3 py-2 text-[var(--muted)] transition-colors hover:text-[var(--text)]"
        aria-label="Cambiar a tema oscuro"
        aria-pressed="false"
        data-theme-toggle
      >
        Tema
      </button>
    </nav>
  </Container>
</header>
