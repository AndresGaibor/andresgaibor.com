---
interface ArchitectureNode {
  label: string;
  detail: string;
  icon?: string;
}

interface Props {
  nodes: ArchitectureNode[];
}

const { nodes } = Astro.props;
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {nodes.map((node, i) => (
    <div class="relative rounded-xl border border-[var(--line)] bg-[var(--surface)] p-4">
      {i < nodes.length - 1 && (
        <div class="hidden lg:block absolute top-1/2 -right-4 w-8 h-px bg-[var(--line)]"></div>
      )}
      {node.icon && (
        <div class="mb-3 text-xl">{node.icon}</div>
      )}
      <p class="text-sm font-semibold text-[var(--text)]">{node.label}</p>
      <p class="mt-1 text-xs text-[var(--muted)]">{node.detail}</p>
    </div>
  ))}
</div>
