---
import type { CollectionEntry } from 'astro:content';
import OptimusDashboard from '../project-visuals/OptimusDashboard.astro';
import SemillasDashboard from '../project-visuals/SemillasDashboard.astro';
import DesktopRemoteDashboard from '../project-visuals/DesktopRemoteDashboard.astro';
import DemoBadge from '../ui/DemoBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  variant: 'primary' | 'secondary';
}

const { project, variant } = Astro.props;
const primary = variant === 'primary';
const statusLabels = {
  active: 'En desarrollo',
  prototype: 'Prototipo',
  completed: 'Completado',
} as const;
const narratives = {
  'optimus-thy': {
    problem: 'Información clínica, estudios, imágenes y resultados pueden quedar dispersos entre procesos y formatos.',
    built: 'Una aplicación web para gestionar pacientes, estudios e imágenes, consumir el modelo de IA y presentar resultados con trazabilidad.',
    participation: 'Diseño y desarrollo del componente de software de la tesis; el modelo clínico no forma parte de mi desarrollo.',
  },
  semillas: {
    problem: 'Contenido, actividades, progreso y administración necesitan convivir en un mismo producto, también con uso parcial sin conexión.',
    built: 'Una plataforma full stack con contenido, actividades interactivas, seguimiento de progreso, administración y PWA con funcionamiento offline parcial.',
    participation: 'Producto de extremo a extremo: UX, frontend, backend, datos, seguridad y evolución del modelo de contenido.',
  },
  'desktop-remote': {
    problem: 'Dar a un agente acceso directo a una máquina completa crea problemas de seguridad, observabilidad y portabilidad.',
    built: 'Un servidor MCP que expone archivos, procesos, terminal y otras capacidades como herramientas explícitas y auditables.',
    participation: 'Diseño del tooling, contratos de herramientas, procesos locales, túneles y controles de seguridad práctica.',
  },
} as const;
const narrative = narratives[project.id as keyof typeof narratives];
---

<a
  href={`/proyectos/${project.id}`}
  class:list={[
    'group block h-full rounded-[1.75rem] border border-[var(--line)] bg-[var(--surface)] no-underline transition-[transform,border-color] hover:-translate-y-1 hover:border-[var(--muted)]',
    primary ? 'p-7 sm:p-9 lg:p-10' : 'p-6 sm:p-7',
  ]}
>
  <div class:list={[primary && 'lg:grid lg:grid-cols-[1.05fr_.95fr] lg:gap-12']}>
    <div>
      <div class="flex items-center justify-between gap-4 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--muted)]">
        <span>{project.data.year}</span>
        <span>{statusLabels[project.data.status]}</span>
      </div>
      <h3 class:list={['mt-5 font-semibold tracking-[-0.035em]', primary ? 'text-3xl sm:text-4xl' : 'text-2xl']}>
        {project.data.title}
      </h3>
      <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{project.data.description}</p>
      {narrative && (
        <dl class="mt-7 space-y-5 border-t border-[var(--line)] pt-6 text-sm leading-6">
          <div><dt class="font-semibold">Problema</dt><dd class="mt-1 text-[var(--muted)]">{narrative.problem}</dd></div>
          <div><dt class="font-semibold">Qué construí</dt><dd class="mt-1 text-[var(--muted)]">{narrative.built}</dd></div>
          <div><dt class="font-semibold">Mi participación</dt><dd class="mt-1 text-[var(--muted)]">{narrative.participation}</dd></div>
        </dl>
      )}
      <ul class="mt-6 flex flex-wrap gap-x-3 gap-y-1 text-xs font-medium text-[var(--muted)]" aria-label={`Tecnologías de ${project.data.title}`}>
        {project.data.technologies.slice(0, 5).map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-5 text-xs font-medium text-[var(--muted)]">{project.data.categories.join(' · ')}</p>
      <div class="mt-7 flex items-center justify-between gap-4">
        <span class="text-sm font-semibold text-[var(--accent)]">Ver caso de estudio →</span>
        <DemoBadge />
      </div>
    </div>

    <div class:list={['overflow-hidden rounded-2xl border border-[var(--line)]', primary ? 'mt-9 lg:mt-0' : 'mt-6']}>
      {project.id === 'optimus-thy' && <OptimusDashboard />}
      {project.id === 'semillas' && <SemillasDashboard />}
      {project.id === 'desktop-remote' && <DesktopRemoteDashboard />}
    </div>
  </div>
</a>
