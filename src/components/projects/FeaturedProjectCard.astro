---
import type { CollectionEntry } from 'astro:content';
import OptimusDashboard from '../project-visuals/OptimusDashboard.astro';
import SemillasDashboard from '../project-visuals/SemillasDashboard.astro';
import DesktopRemoteDashboard from '../project-visuals/DesktopRemoteDashboard.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  variant: 'primary' | 'secondary';
}

const { project, variant } = Astro.props;
const primary = variant === 'primary';
const statusLabels = {
  active: 'En desarrollo',
  prototype: 'Prototipo',
  completed: 'Completado',
} as const;
---

<a
  href={`/proyectos/${project.id}`}
  class:list={[
    'group block h-full rounded-[1.75rem] border border-[var(--line)] bg-[var(--surface)] no-underline transition-[transform,border-color] hover:-translate-y-1 hover:border-[var(--muted)]',
    primary ? 'p-7 sm:p-9 lg:p-10' : 'p-6 sm:p-7',
  ]}
>
  <div class:list={[primary && 'lg:grid lg:grid-cols-[1.2fr_.8fr] lg:gap-12']}>
    <div>
      <div class="flex items-center justify-between gap-4 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--muted)]">
        <span>{project.data.year}</span>
        <span>{statusLabels[project.data.status]}</span>
      </div>
      <h3 class:list={['mt-6 font-semibold tracking-[-0.035em]', primary ? 'text-3xl sm:text-4xl' : 'text-2xl']}>
        {project.data.title}
      </h3>
      <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{project.data.description}</p>
      <ul class="mt-6 flex flex-wrap gap-2" aria-label={`Tecnologías de ${project.data.title}`}>
        {project.data.technologies.slice(0, 5).map((item) => (
          <li class="rounded-lg bg-[var(--surface-soft)] px-2.5 py-1.5 text-xs font-medium text-[var(--muted)]">
            {item}
          </li>
        ))}
      </ul>
      <p class="mt-5 text-xs font-medium text-[var(--muted)]">{project.data.categories.join(' · ')}</p>
      <p class="mt-8 text-sm font-semibold text-[var(--accent)]">Ver caso de estudio →</p>
    </div>

    {primary && (
      <div class="mt-9 overflow-hidden rounded-2xl border border-[var(--line)] lg:mt-0">
        {project.id === 'optimus-thy' ? (
          <OptimusDashboard />
        ) : (
          <div class="min-h-48 bg-[var(--surface-soft)] p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--muted)]">
              Proyecto principal
            </p>
            <div class="mt-12 border-t border-[var(--line)] pt-5">
              <p class="text-4xl font-semibold tracking-[-0.06em]">01</p>
              <p class="mt-3 max-w-xs text-sm leading-6 text-[var(--muted)]">
                Producto, datos, IA asistida, privacidad y trazabilidad dentro de una sola arquitectura.
              </p>
            </div>
          </div>
        )}
      </div>
    )}
  </div>

  {!primary && (
    <div class="mt-6 overflow-hidden rounded-2xl border border-[var(--line)]">
      {project.id === 'semillas' && <SemillasDashboard />}
      {project.id === 'desktop-remote' && <DesktopRemoteDashboard />}
    </div>
  )}
</a>
