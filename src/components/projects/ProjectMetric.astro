---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<div class="space-y-1">
  <p class="text-xs font-medium uppercase tracking-[0.1em] text-[var(--muted)]">{label}</p>
  <p class="text-2xl font-semibold tracking-[-0.04em] text-[var(--text)]">{value}</p>
</div>
