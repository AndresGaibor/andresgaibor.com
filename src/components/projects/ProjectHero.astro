---
interface Props {
  title: string;
  description: string;
  year: string;
  status: string;
  categories: string[];
  technologies: string[];
}

const { title, description, year, status, categories, technologies } = Astro.props;
const statusLabels: Record<string, string> = { active: 'En desarrollo', prototype: 'Prototipo', completed: 'Completado' };
---

<div class="space-y-6">
  <div class="flex items-center gap-4 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--muted)]">
    <span>{year}</span>
    <span class="size-1 rounded-full bg-[var(--muted)]"></span>
    <span>{statusLabels[status] ?? status}</span>
  </div>

  <h1 class="text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">{title}</h1>

  <p class="max-w-2xl text-lg leading-7 text-[var(--muted)]">{description}</p>

  <div class="flex flex-wrap gap-2 pt-2">
    {technologies.map((tech) => (
      <span class="rounded-lg bg-[var(--surface-soft)] px-2.5 py-1.5 text-xs font-medium text-[var(--muted)]">
        {tech}
      </span>
    ))}
  </div>

  <p class="text-xs font-medium text-[var(--muted)]">{categories.join(' · ')}</p>
</div>
