---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index } = Astro.props;
---

<a href={`/proyectos/${project.id}`} class="group flex h-full flex-col rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-6 no-underline transition-transform hover:-translate-y-1 sm:p-7">
  <div class="flex items-center justify-between gap-4 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--muted)]">
    <span>{index ? String(index).padStart(2, '0') : project.data.year}</span>
    <span>{project.data.status}</span>
  </div>
  <h2 class="mt-7 text-2xl font-semibold tracking-[-0.03em]">{project.data.title}</h2>
  <p class="mt-3 leading-7 text-[var(--muted)]">{project.data.description}</p>
  <p class="mt-5 text-xs font-medium text-[var(--muted)]">{project.data.categories.join(' · ')}</p>
  <p class="mt-auto pt-8 text-sm font-semibold text-[var(--accent)]">Ver caso de estudio →</p>
</a>
