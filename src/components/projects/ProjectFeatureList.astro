---
interface FeatureItem {
  title: string;
  description: string;
}

interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<ul class="space-y-4">
  {items.map((item) => (
    <li class="flex gap-3">
      <svg class="mt-0.5 size-4 shrink-0 text-[var(--accent)]" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 8 6 11 13 4"/>
      </svg>
      <div>
        <p class="text-sm font-semibold text-[var(--text)]">{item.title}</p>
        <p class="mt-0.5 text-sm text-[var(--muted)]">{item.description}</p>
      </div>
    </li>
  ))}
</ul>
