---
import DataPipelineCover from './cover/DataPipelineCover.astro';
import PrivacyCover from './cover/PrivacyCover.astro';
import RemoteToolsCover from './cover/RemoteToolsCover.astro';

interface Props {
  title: string;
  description: string;
  cover: 'pipeline' | 'privacy' | 'remote';
}

const { title, description, cover } = Astro.props;

const covers = {
  pipeline: DataPipelineCover,
  privacy: PrivacyCover,
  remote: RemoteToolsCover,
} as const;

const CoverComponent = covers[cover];
---

<div class="group block rounded-2xl border border-dashed border-[var(--line)] bg-[var(--surface)] p-6 no-underline sm:p-7">
  <div class="aspect-[16/9] w-full overflow-hidden rounded-xl bg-[var(--surface-soft)]">
    <CoverComponent />
  </div>
  <div class="mt-4">
    <span class="inline-flex items-center rounded-full border border-[var(--accent)] bg-[var(--accent-soft)] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-[var(--accent)]">
      En preparación
    </span>
  </div>
  <h3 class="mt-4 text-xl font-semibold tracking-[-0.025em] text-[var(--muted)]">{title}</h3>
  <p class="mt-2 leading-6 text-[var(--muted)] opacity-70">{description}</p>
</div>
