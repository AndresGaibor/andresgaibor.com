---
---

<div class="relative flex h-full w-full items-center justify-center overflow-hidden rounded-2xl bg-[var(--surface-soft)] p-8">
  <div class="absolute right-0 top-0 h-32 w-32 rounded-full bg-[var(--accent)] opacity-5 blur-3xl"></div>
  <div class="absolute bottom-0 left-0 h-24 w-24 rounded-full bg-[var(--accent)] opacity-5 blur-3xl"></div>

  <div class="relative z-10 w-full max-w-[280px]">
    <div class="rounded-xl border border-[var(--line)] bg-[var(--surface)] shadow-sm">
      <div class="flex items-center gap-2 border-b border-[var(--line)] px-4 py-2.5">
        <div class="flex gap-1.5">
          <div class="h-3 w-3 rounded-full border border-[var(--line)]"></div>
          <div class="h-3 w-3 rounded-full border border-[var(--line)]"></div>
          <div class="h-3 w-3 rounded-full border border-[var(--line)]"></div>
        </div>
        <div class="ml-2 flex-1 rounded-md bg-[var(--surface-soft)] px-3 py-1 text-center text-[10px] font-medium text-[var(--muted)]">terminal</div>
      </div>
      <div class="p-4 font-mono text-sm">
        <div class="flex items-center gap-2">
          <span class="text-[var(--accent)]">$</span>
          <span class="text-[var(--muted)]">connection</span>
          <span class="animate-pulse text-[var(--accent)]">...</span>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <span class="ml-4 text-[var(--muted)]">status</span>
          <span class="h-2 w-2 rounded-full bg-[var(--accent)]"></span>
          <span class="text-[var(--accent)]">connected</span>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <div class="ml-4 flex gap-1">
            <div class="h-2 w-2 rounded-full bg-[var(--accent)] opacity-80"></div>
            <div class="h-2 w-2 rounded-full bg-[var(--accent)] opacity-60"></div>
            <div class="h-2 w-2 rounded-full bg-[var(--accent)] opacity-40"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  .animate-pulse {
    animation: pulse 2s ease-in-out infinite;
  }
</style>
