---
import DemoBadge from '../ui/DemoBadge.astro';
---

<div class="overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--surface)]">
  <div class="flex items-center justify-between border-b border-[var(--line)] px-4 py-3">
    <span class="text-sm font-semibold text-[var(--text)]">Optimus THY</span>
    <DemoBadge />
  </div>

  <div class="grid grid-cols-1 md:grid-cols-[160px_1fr]">
    <aside class="hidden md:block border-r border-[var(--line)] p-4">
      <nav aria-label="Navegación del dashboard" class="space-y-1">
        <button type="button" class="flex w-full items-center gap-2 rounded-lg bg-[var(--accent-soft)] px-3 py-2 text-xs font-medium text-[var(--accent)]">
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="12" height="12" rx="2"/><path d="M5 8h6"/></svg>
          Resumen
        </button>
        <button type="button" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-[var(--muted)] hover:bg-[var(--surface-soft)]">
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h8v8H4z"/><path d="M7 7h2v2H7z"/></svg>
          Docs
        </button>
        <button type="button" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-[var(--muted)] hover:bg-[var(--surface-soft)]">
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8h12M8 2l4 6-4 6"/></svg>
          Flujo
        </button>
        <button type="button" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-[var(--muted)] hover:bg-[var(--surface-soft)]">
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
          Auditoría
        </button>
      </nav>
    </aside>

    <div class="p-4 space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="rounded-xl border border-[var(--line)] bg-[var(--surface-soft)] p-3">
          <p class="text-xs text-[var(--muted)]">Documentos</p>
          <p class="mt-1 text-xl font-semibold text-[var(--text)]">Varios formatos</p>
        </div>
        <div class="rounded-xl border border-[var(--line)] bg-[var(--surface-soft)] p-3">
          <p class="text-xs text-[var(--muted)]">Procesamiento</p>
          <p class="mt-1 text-xl font-semibold text-[var(--text)]">En curso</p>
        </div>
        <div class="rounded-xl border border-[var(--line)] bg-[var(--surface-soft)] p-3">
          <p class="text-xs text-[var(--muted)]">Auditoría</p>
          <p class="mt-1 text-xl font-semibold text-[var(--text)]">Activa</p>
        </div>
      </div>

      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--muted)]">Actividad reciente</p>
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-[var(--text)]">documento_01.pdf</span>
            <span class="text-[var(--muted)]">Hace instantes</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-[var(--text)]">estudio_02.pdf</span>
            <span class="text-[var(--muted)]">Hace un momento</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-[var(--text)]">resultado_03.pdf</span>
            <span class="text-[var(--muted)]">Hoy</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
