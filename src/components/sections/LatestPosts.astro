---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import PostCard from '../blog/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<section class="border-y border-[var(--line)] py-16 sm:py-20">
  <Container>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        eyebrow="Ideas y aprendizajes"
        title="Notas nacidas de problemas reales."
        description="Escribo sobre decisiones de software, automatización, datos e inteligencia artificial que aparecen al construir sistemas."
      />
      <a href="/blog" class="text-sm font-semibold text-[var(--accent)]">Ver blog →</a>
    </div>
    <div class="mt-10 grid gap-5">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </Container>
</section>
