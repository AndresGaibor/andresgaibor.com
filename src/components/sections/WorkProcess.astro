---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { workProcess } from '../../data/work-process';
---

<section class="border-y border-[var(--line)] bg-[var(--surface-soft)] py-16 sm:py-20">
  <Container>
    <SectionHeading
      eyebrow="Cómo trabajo"
      title="Del problema a una solución que puedas usar."
      description="No necesitas llegar con requisitos técnicos. El proceso empieza por entender qué quieres mejorar."
    />
    <ol class="mt-10 divide-y divide-[var(--line)] border-y border-[var(--line)]">
      {workProcess.map((item, index) => (
        <li class="grid gap-4 py-6 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-8 sm:py-7">
          <p class="text-sm font-semibold tabular-nums text-[var(--muted)]">{String(index + 1).padStart(2, '0')}</p>
          <div>
            <h3 class="text-xl font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </Container>
</section>
