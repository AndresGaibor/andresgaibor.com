---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../projects/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<section class="py-20 sm:py-24">
  <Container>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading eyebrow="Trabajo destacado" title="Proyectos que demuestran cómo construyo." />
      <a href="/proyectos" class="text-sm font-semibold text-[var(--accent)]">Ver todos →</a>
    </div>
    <div class="mt-12 grid gap-5 lg:grid-cols-3">{projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}</div>
  </Container>
</section>
