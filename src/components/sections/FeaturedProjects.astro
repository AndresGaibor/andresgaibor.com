---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const projects = [
  {
    title: 'Qlik Report',
    description: 'Automatización de reporting y transformación de procesos de datos hacia BigQuery.',
    area: 'Software Engineering · Data Engineering',
  },
  {
    title: 'Semillas',
    description: 'Plataforma educativa interactiva construida como producto full stack.',
    area: 'Product Engineering · Full Stack',
  },
  {
    title: 'Desktop Remote',
    description: 'Infraestructura para que agentes autorizados puedan trabajar con computadores remotos de forma controlada.',
    area: 'Developer Tools · AI Infrastructure',
  },
];
---

<section class="py-20 sm:py-24">
  <Container>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading eyebrow="Trabajo destacado" title="Proyectos que demuestran cómo construyo." />
      <a href="/proyectos" class="text-sm font-semibold text-[var(--accent)]">Ver todos →</a>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {projects.map((project, index) => (
        <article class="group flex min-h-64 flex-col rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-7">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--muted)]">0{index + 1} · {project.area}</p>
          <h3 class="mt-7 text-2xl font-semibold tracking-[-0.03em]">{project.title}</h3>
          <p class="mt-3 leading-7 text-[var(--muted)]">{project.description}</p>
          <p class="mt-auto pt-8 text-sm font-semibold text-[var(--accent)]">Caso de estudio próximamente en la colección →</p>
        </article>
      ))}
    </div>
  </Container>
</section>
