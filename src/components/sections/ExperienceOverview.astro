---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { experience } from '../../data/experience';
import { coreTechnologies } from '../../data/skills';
import { social } from '../../data/social';
---

<section class="py-16 sm:py-20">
  <Container>
    <SectionHeading
      eyebrow="Perfil técnico"
      title="Para equipos técnicos y reclutadores"
      description="Trabajo desde la interfaz y el backend hasta datos, automatización e infraestructura."
    />
    <div class="mt-10 grid gap-10 border-t border-[var(--line)] pt-7 lg:grid-cols-[1.35fr_.65fr] lg:gap-16">
      <div class="grid gap-7 sm:grid-cols-3">
        {experience.map((item) => (
          <article>
            <h3 class="text-lg font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
          </article>
        ))}
      </div>
      <aside class="border-t border-[var(--line)] pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
        <p class="text-sm font-semibold">Stack agrupado</p>
        <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{coreTechnologies.join(' · ')}</p>
        <div class="mt-7 flex flex-wrap gap-x-4 gap-y-2 text-sm font-semibold">
          <a href="/cv" class="text-[var(--accent)] no-underline">Ver CV →</a>
          <a href="/experiencia" class="text-[var(--accent)] no-underline">Ver experiencia →</a>
          <a href={social.github} class="text-[var(--accent)] no-underline" target="_blank" rel="noreferrer">GitHub →</a>
        </div>
      </aside>
    </div>
  </Container>
</section>
