---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { experience } from '../../data/experience';
import { education } from '../../data/education';
import { coreTechnologies } from '../../data/skills';
---

<section class="py-16 sm:py-20">
  <Container>
    <SectionHeading
      eyebrow="Perfil técnico"
      title="También puedo entrar al detalle técnico."
      description="Para equipos y reclutadores: trabajo desde la interfaz y el backend hasta datos, automatización e infraestructura."
    />
    <div class="mt-10 grid gap-12 lg:grid-cols-[1.35fr_.65fr]">
      <div class="space-y-8">
        {experience.map((item) => (
          <article class="border-t border-[var(--line)] pt-6">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--muted)]">
              {item.period}
            </p>
            <h3 class="mt-2 text-xl font-semibold">{item.title}</h3>
            <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{item.description}</p>
          </article>
        ))}
      </div>
      <aside class="space-y-8">
        <div>
          <p class="text-sm text-[var(--muted)]">Formación</p>
          {education.map((item) => (
            <p class="mt-2 font-semibold">{item.title} · {item.institution}</p>
          ))}
        </div>
        <div>
          <p class="text-sm text-[var(--muted)]">Tecnologías principales</p>
          <p class="mt-2 leading-7">{coreTechnologies.join(' · ')}</p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a
            href="/cv"
            class="rounded-xl bg-[var(--text)] px-4 py-2.5 text-sm font-semibold text-[var(--page)] no-underline"
          >
            Ver CV →
          </a>
          <a href="/experiencia" class="py-2.5 text-sm font-semibold text-[var(--accent)] no-underline">
            Ver experiencia →
          </a>
        </div>
      </aside>
    </div>
  </Container>
</section>
