---
import { profile } from '../../data/profile';
---

<aside class="relative mx-auto w-full max-w-sm rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-7 lg:mx-0 lg:justify-self-end">
  <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--accent)]">Puedo ayudarte con</p>
  <ul class="mt-6 space-y-4">
    <li class="border-t border-[var(--line)] pt-4 font-semibold">Sistemas para administrar procesos</li>
    <li class="border-t border-[var(--line)] pt-4 font-semibold">Automatización de tareas repetitivas</li>
    <li class="border-t border-[var(--line)] pt-4 font-semibold">Datos, reportes e integraciones</li>
    <li class="border-t border-[var(--line)] pt-4 font-semibold">Software web a medida</li>
  </ul>
  <p class="mt-8 border-t border-[var(--line)] pt-5 text-sm text-[var(--muted)]">Trabajo desde {profile.location}</p>
</aside>
