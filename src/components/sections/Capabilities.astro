---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { capabilities } from '../../data/skills';
---

<section id="servicios" class="border-y border-[var(--line)] py-16 sm:py-20">
  <Container>
    <SectionHeading
      eyebrow="En qué te puedo ayudar"
      title="Soluciones para organizar, automatizar y mejorar tu trabajo."
      description="No necesitas saber qué tecnología usar. Podemos empezar por el problema y decidir qué solución tiene sentido."
    />
    <div class="mt-10 divide-y divide-[var(--line)] border-t border-[var(--line)]">
      {capabilities.map((capability, index) => (
        <article class="grid gap-5 py-7 sm:grid-cols-[5rem_minmax(0,1fr)_minmax(12rem,.7fr)] sm:gap-8 sm:py-9">
          <p class="text-sm font-semibold tabular-nums text-[var(--muted)]">{String(index + 1).padStart(2, '0')}</p>
          <div>
            <h3 class="text-xl font-semibold tracking-tight">{capability.title}</h3>
            <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{capability.description}</p>
          </div>
          <ul class="flex flex-wrap content-start gap-x-3 gap-y-2 text-xs font-medium text-[var(--muted)] sm:justify-end" aria-label={`Tecnologías de ${capability.title}`}>
            {capability.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </Container>
</section>
