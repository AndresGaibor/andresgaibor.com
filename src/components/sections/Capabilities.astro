---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { capabilities } from '../../data/skills';
---

<section class="border-y border-[var(--line)] py-20 sm:py-24">
  <Container>
    <SectionHeading
      eyebrow="Lo que hago"
      title="Ingeniería de producto, datos y automatización."
      description="No me interesa coleccionar tecnologías: las uso para construir sistemas claros, mantenibles y útiles."
    />

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {capabilities.map((capability) => (
        <article class="rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-7">
          <h3 class="text-xl font-semibold tracking-tight">{capability.title}</h3>
          <p class="mt-3 leading-7 text-[var(--muted)]">{capability.description}</p>
          <ul class="mt-6 flex flex-wrap gap-2" aria-label={`Tecnologías de ${capability.title}`}>
            {capability.items.map((item) => (
              <li class="rounded-lg bg-[var(--surface-soft)] px-2.5 py-1.5 text-xs font-medium text-[var(--muted)]">{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Container>
</section>
