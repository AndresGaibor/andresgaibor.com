---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { capabilities } from '../../data/skills';
---

<section id="servicios" class="border-y border-[var(--line)] py-16 sm:py-20">
  <Container>
    <SectionHeading
      eyebrow="En qué te puedo ayudar"
      title="Soluciones para organizar, automatizar y mejorar tu trabajo."
      description="No necesitas saber qué tecnología usar. Podemos empezar por el problema y decidir qué solución tiene sentido."
    />
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {capabilities.map((capability) => (
        <article class="rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-7">
          <h3 class="text-xl font-semibold tracking-tight">{capability.title}</h3>
          <p class="mt-3 leading-7 text-[var(--muted)]">{capability.description}</p>
          <ul class="mt-6 flex flex-wrap gap-2" aria-label={`Tecnologías de ${capability.title}`}>
            {capability.items.map((item) => (
              <li class="rounded-lg bg-[var(--surface-soft)] px-2.5 py-1.5 text-xs font-medium text-[var(--muted)]">
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Container>
</section>
