---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
---

<BaseLayout title="Página no encontrada" description="La página solicitada no existe." noindex>
  <Container class="grid min-h-[60vh] place-items-center py-20 text-center">
    <div><p class="text-sm font-semibold text-[var(--accent)]">404</p><h1 class="mt-3 text-4xl font-semibold tracking-[-0.05em]">Esta página no existe.</h1><p class="mt-4 text-[var(--muted)]">Puede que haya cambiado de dirección o todavía no la haya publicado.</p><a href="/" class="mt-7 inline-block font-semibold text-[var(--accent)]">Volver al inicio →</a></div>
  </Container>
</BaseLayout>
