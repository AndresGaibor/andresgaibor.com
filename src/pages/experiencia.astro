---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { experience } from '../data/experience';
import { coreTechnologies } from '../data/skills';
---

<BaseLayout
  title="Áreas de experiencia"
  description="Áreas de experiencia, capacidades y tecnologías de Andrés Gaibor."
>
  <Container class="py-16 sm:py-20">
    <SectionHeading
      eyebrow="Áreas de experiencia"
      title="Qué puedo aportar a un equipo técnico."
      description="Estas áreas resumen el tipo de trabajo que realizo. Los proyectos muestran cómo las combino en sistemas completos."
    />
    <div class="mt-10 divide-y divide-[var(--line)] border-y border-[var(--line)]">
      {experience.map((item) => (
        <article class="grid gap-3 py-8 sm:grid-cols-[180px_1fr] sm:gap-8">
          <p class="text-sm font-medium text-[var(--muted)]">{item.period}</p>
          <div>
            <h2 class="text-xl font-semibold">{item.title}</h2>
            <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight">Tecnologías principales</h2>
      <ul class="mt-6 flex flex-wrap gap-2">
        {coreTechnologies.map((item) => (
          <li class="rounded-lg border border-[var(--line)] bg-[var(--surface)] px-3 py-2 text-sm">
            {item}
          </li>
        ))}
      </ul>
    </section>
  </Container>
</BaseLayout>
