---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import EmailAddress from '../components/ui/EmailAddress.astro';
import { profile } from '../data/profile';
import { social } from '../data/social';
import { experience } from '../data/experience';
import { education } from '../data/education';
import { coreTechnologies } from '../data/skills';
---

<BaseLayout title="CV" description={`CV web de ${profile.name}.`}>
  <Container class="py-16 sm:py-20">
    <div class="no-print mb-8 flex flex-wrap items-center justify-between gap-4">
      <p class="text-sm text-[var(--muted)]">Versión web imprimible del CV.</p>
      <button id="print-cv" type="button" class="rounded-xl border border-[var(--line)] bg-[var(--surface)] px-4 py-2.5 text-sm font-semibold">Guardar como PDF</button>
    </div>

    <article class="mx-auto max-w-4xl rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-7 sm:p-10 print:border-0 print:p-0">
      <header class="border-b border-[var(--line)] pb-8">
        <h1 class="text-4xl font-semibold tracking-[-0.05em]">{profile.name}</h1>
        <p class="mt-2 text-lg text-[var(--muted)]">{profile.role}</p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[var(--muted)]">
          <span>{profile.location}</span>
          <EmailAddress tone="muted" />
          <a href={social.github}>github.com/AndresGaibor</a>
          <a href={profile.site}>andresgaibor.com</a>
        </div>
      </header>

      <section class="py-8"><h2 class="text-lg font-semibold">Perfil</h2><p class="mt-3 leading-7 text-[var(--muted)]">{profile.summary}</p></section>
      <section class="border-t border-[var(--line)] py-8">
        <h2 class="text-lg font-semibold">Experiencia y proyectos</h2>
        <div class="mt-5 space-y-6">{experience.map((item) => <div><p class="text-xs font-semibold uppercase tracking-wider text-[var(--muted)]">{item.period}</p><h3 class="mt-1 font-semibold">{item.title}</h3><p class="mt-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p></div>)}</div>
      </section>
      <section class="border-t border-[var(--line)] py-8"><h2 class="text-lg font-semibold">Formación</h2>{education.map((item) => <div class="mt-4"><h3 class="font-semibold">{item.title} · {item.institution}</h3><p class="mt-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p></div>)}</section>
      <section class="border-t border-[var(--line)] pt-8"><h2 class="text-lg font-semibold">Tecnologías</h2><p class="mt-3 text-sm leading-7 text-[var(--muted)]">{coreTechnologies.join(' · ')}</p></section>
    </article>
  </Container>
  <script>
    document.querySelector('#print-cv')?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>
