---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
---

<BaseLayout title="Ahora" description="En qué está trabajando y aprendiendo Andrés Gaibor actualmente.">
  <Container class="py-20 sm:py-28">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Ahora</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-[-0.05em] sm:text-6xl">Lo que estoy construyendo y aprendiendo.</h1>
      <p class="mt-5 text-sm text-[var(--muted)]">Última actualización: agosto de 2026.</p>
      <div class="prose-site mt-10">
        <ul>
          <li>Sistemas de reporting y procesamiento de datos con BigQuery.</li>
          <li>Compilación y transformación de lógica de Qlik hacia SQL.</li>
          <li>Herramientas para automatización y agentes de IA.</li>
          <li>Arquitectura de software, infraestructura y developer tooling.</li>
          <li>Construcción de este sitio y documentación técnica de proyectos.</li>
        </ul>
      </div>
    </div>
  </Container>
</BaseLayout>
