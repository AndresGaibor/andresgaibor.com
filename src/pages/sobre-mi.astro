---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { profile } from '../data/profile';
import { education } from '../data/education';
import { experience } from '../data/experience';
---

<BaseLayout
  title="Sobre mí"
  description="Quién es Andrés Gaibor, cómo trabaja y qué tipo de problemas le interesa resolver."
>
  <Container class="py-16 sm:py-20">
    <header class="max-w-4xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">Sobre mí</p>
      <p class="mt-5 text-sm font-semibold uppercase tracking-[0.14em] text-[var(--muted)]">{profile.role}</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-[-0.05em] sm:text-6xl">
        Me gusta entender el problema completo antes de construir la solución.
      </h1>
      <div class="prose-site mt-8 max-w-3xl">
        <p>
          Soy ingeniero de software y trabajo creando sistemas que conectan personas, procesos y datos. Me interesa especialmente simplificar tareas complejas, reducir trabajo manual y convertir información dispersa en herramientas que realmente se puedan utilizar.
        </p>
        <p>
          Técnicamente trabajo desde la interfaz y el backend hasta bases de datos, automatización, infraestructura e integración de sistemas.
        </p>
        <p>
          Uso esta web para documentar proyectos, decisiones técnicas y aprendizajes que puedan ser útiles para otros desarrolladores y equipos.
        </p>
      </div>
    </header>

    <figure class="mt-12 overflow-hidden border-y border-[var(--line)] py-5 sm:mt-16 sm:py-8">
      <img
        src="/images/portrait-about.webp"
        width="1672"
        height="941"
        loading="lazy"
        decoding="async"
        alt="Andrés Gaibor trabajando en un entorno de desarrollo de software"
        class="h-auto w-full object-cover"
        style="aspect-ratio: 1672 / 941;"
      />
    </figure>

    <div class="mt-12 grid gap-12 border-t border-[var(--line)] pt-8 lg:grid-cols-[.75fr_1.25fr] lg:gap-16 sm:mt-16">
      <section aria-labelledby="datos-title">
        <h2 id="datos-title" class="text-2xl font-semibold tracking-tight">Datos</h2>
        <dl class="mt-6 divide-y divide-[var(--line)] border-y border-[var(--line)] text-sm">
          <div class="py-4">
            <dt class="text-[var(--muted)]">Ubicación</dt>
            <dd class="mt-1 font-medium">{profile.location}</dd>
          </div>
          <div class="py-4">
            <dt class="text-[var(--muted)]">Formación</dt>
            <dd class="mt-1 font-medium">{education[0].title} · {education[0].institution}</dd>
            <dd class="mt-2 leading-6 text-[var(--muted)]">{education[0].description}</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="areas-title">
        <h2 id="areas-title" class="text-2xl font-semibold tracking-tight">Áreas en las que puedo aportar</h2>
        <ol class="mt-6 divide-y divide-[var(--line)] border-y border-[var(--line)]">
          {experience.map((item) => (
            <li class="grid gap-3 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
              <p class="text-sm text-[var(--muted)]">{item.period}</p>
              <div>
                <h3 class="font-semibold">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{item.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <nav class="mt-12 flex flex-wrap gap-3 border-t border-[var(--line)] pt-8" aria-label="Siguiente paso">
      <a href="/proyectos" class="rounded-xl bg-[var(--text)] px-5 py-3 text-sm font-semibold text-[var(--page)] no-underline">Ver proyectos</a>
      <a href="/cv" class="rounded-xl border border-[var(--line)] bg-[var(--surface)] px-5 py-3 text-sm font-semibold no-underline">Ver CV</a>
    </nav>
  </Container>
</BaseLayout>
