{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "andresgaibor-com",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "andresgaibor.com", "custom_domain": true },
    { "pattern": "www.andresgaibor.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
